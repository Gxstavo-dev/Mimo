{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mimo",
  "version": "0.1.0",
  "identifier": "com.gxstavo-dev.mimo",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "mimo",
        "width": 1200,
        "minWidth": 1200,
        "height": 650,
        "minHeight": 650,
        "decorations": false,
        "backgroundColor": "#FAFAFA"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Gxstavo-dev",
    "copyright": "Copyright © 2026 Gxstavo-dev",
    "homepage": "https://github.com/Gxstavo-dev/mimo",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "shortDescription": "A personal notes app in Tauri that works with Codex",
    "category": "Productivity",
    "linux": {
      "deb": {
        "files": {
          "/usr/share/doc/mimo/copyright": "../LICENSE",
          "/usr/share/doc/mimo/NOTICE": "../NOTICE"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/licenses/mimo/LICENSE": "../LICENSE",
          "/usr/share/licenses/mimo/NOTICE": "../NOTICE"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/doc/mimo/LICENSE": "../LICENSE",
          "/usr/share/doc/mimo/NOTICE": "../NOTICE"
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
